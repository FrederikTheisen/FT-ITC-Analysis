<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FT-ITC Analysis</AssemblyName>
    <Product>FT-ITC Analysis</Product>
    <Nullable>enable</Nullable>
    <Version>1.4.2</Version>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <FileVersion>1.4.2.0</FileVersion>
    <ApplicationIcon>..\Resources\appicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ReleaseVersion>1.1</ReleaseVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Resources\appicon.ico" LogicalName="AnalysisITC.Avalonia.Resources.appicon.ico" />
    <EmbeddedResource Include="..\Resources\HelpTextResource.txt" LogicalName="AnalysisITC.Avalonia.Resources.HelpTextResource.txt" />
    <EmbeddedResource Include="..\Resources\ScienceHelpResource.txt" LogicalName="AnalysisITC.Avalonia.Resources.ScienceHelpResource.txt" />
    <EmbeddedResource Include="Assets\Fonts\Inter\Inter-Light.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.Inter.Inter-Light.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter\Inter-LightItalic.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.Inter.Inter-LightItalic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter\Inter-Medium.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.Inter.Inter-Medium.ttf" />
    <EmbeddedResource Include="Assets\Fonts\Inter\Inter-MediumItalic.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.Inter.Inter-MediumItalic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\LiberationSans\LiberationSans-Regular.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.LiberationSans.LiberationSans-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\LiberationSans\LiberationSans-Italic.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.LiberationSans.LiberationSans-Italic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\LiberationSans\LiberationSans-Bold.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.LiberationSans.LiberationSans-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\LiberationSans\LiberationSans-BoldItalic.ttf" LogicalName="AnalysisITC.Avalonia.Assets.Fonts.LiberationSans.LiberationSans-BoldItalic.ttf" />
    <Content Include="..\Resources\AppIcon.icns" Link="Resources\AppIcon.icns" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\citation.json" Link="citation.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\Licenses\*.txt" Link="Licenses\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\PROVENANCE.md" Link="Licenses\Fonts\PROVENANCE.md" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <!-- DiagnosticsSupport 2.2.3 deliberately exposes no NuGet compile asset.
         Reference its Avalonia 12 bridge explicitly in Debug builds. -->
    <Reference Include="AvaloniaUI.DiagnosticsSupport.Avalonia" Condition="'$(Configuration)' == 'Debug'">
      <HintPath>$(NuGetPackageRoot)avaloniaui.diagnosticssupport/2.2.3/lib/net10.0/AvaloniaUI.DiagnosticsSupport.Avalonia.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnalysisITC.Core\AnalysisITC.Core.csproj">
      <ReferenceSourceTarget></ReferenceSourceTarget>
    </ProjectReference>
  </ItemGroup>
</Project>
