<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:AnalysisITC.Avalonia"
        xmlns:processing="using:AnalysisITC.Avalonia.Processing"
        xmlns:analysis="using:AnalysisITC.Avalonia.Analysis"
        xmlns:finalfigure="using:AnalysisITC.Avalonia.FinalFigure"
        xmlns:results="using:AnalysisITC.Avalonia.Results"
        xmlns:listitems="using:AnalysisITC.Avalonia.ListItems"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
        x:Class="AnalysisITC.Avalonia.MainWindow"
        Title="FT-ITC Analysis"
        Icon="/Resources/appicon.ico"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="600">
    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource WorkspaceBackground}">
        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,0,1">
            <Menu x:Name="InWindowMenu"
                  Background="{DynamicResource PanelBackground}" />
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,0,1,0">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" Margin="12,10,12,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Data / Results"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}" />
                        <TextBlock x:Name="ItemCountText"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource MutedText}" />
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="0,7,0,0">
                            <Button x:Name="IncludeAllButton" Content="All" MinWidth="42" MinHeight="24" />
                            <Button x:Name="IncludeNoneButton" Content="None" MinWidth="52" MinHeight="24" />
                            <TextBlock x:Name="IncludedCountText"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedText}"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="ItemsList"
                             Grid.Row="1"
                             Margin="0,0,0,8"
                             Background="{DynamicResource PanelBackground}"
                             BorderThickness="0">
                        <ListBox.Resources>
                            <ControlTheme x:Key="BareListButtonTheme" TargetType="Button">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Background="{TemplateBinding Background}"
                                                          BorderBrush="{TemplateBinding BorderBrush}"
                                                          BorderThickness="{TemplateBinding BorderThickness}"
                                                          CornerRadius="3"
                                                          Padding="{TemplateBinding Padding}"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center" />
                                    </ControlTemplate>
                                </Setter>
                            </ControlTheme>
                            <ControlTheme x:Key="BareListToggleTheme" TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Background="Transparent"
                                                          Padding="0"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center" />
                                    </ControlTemplate>
                                </Setter>
                            </ControlTheme>
                            <DataTemplate x:Key="LegacyDataListItemTemplate">
                                <Grid ColumnDefinitions="24,*,22" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,2" RowSpacing="0">
                                    <ToggleButton Grid.RowSpan="4"
                                                  Classes="list-active-toggle"
                                                  Theme="{StaticResource BareListToggleTheme}"
                                                  IsVisible="{Binding CanInclude}"
                                                  IsChecked="{Binding IsIncluded}"
                                                  IsEnabled="{Binding CanIncludeActive}"
                                                  PointerPressed="OnInlineListActionPointerPressed"
                                                  ToolTip.Tip="{Binding InclusionLabel}"
                                                  AutomationProperties.Name="{Binding InclusionLabel}"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Top"
                                                  Margin="0,3,0,0">
                                        <Border Classes="active-indicator"
                                                Width="16"
                                                Height="16"
                                                CornerRadius="8">
                                            <Path Classes="active-indicator-check"
                                                  Data="M 4.2,10 L 8.1,13.5 L 15.8,5.6"
                                                  Stroke="{DynamicResource ActiveToggleGlyph}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  Width="7"
                                                  Height="5"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Stretch="Uniform" />
                                        </Border>
                                    </ToggleButton>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               FontSize="13"
                                               LineHeight="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="1"
                                               Text="{Binding DateLine}"
                                               FontSize="10.5"
                                               LineHeight="11.5"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="2"
                                               Text="{Binding DetailLine}"
                                               FontSize="10.5"
                                               LineHeight="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Grid.Column="1"
                                               Grid.Row="3"
                                               Text="{Binding FitLine}"
                                               FontSize="10.5"
                                               LineHeight="11.5"
                                               TextWrapping="Wrap"
                                               MaxLines="2" />
                                    <StackPanel Grid.Column="2"
                                                Grid.RowSpan="4"
                                                Classes="list-action-rail"
                                                Orientation="Vertical"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Spacing="0">
                                        <Button Classes="list-inline-action list-remove-action"
                                                Theme="{StaticResource BareListButtonTheme}"
                                                Click="OnListItemRemoveClick"
                                                PointerPressed="OnInlineListActionPointerPressed"
                                                ToolTip.Tip="{Binding RemoveLabel}"
                                                AutomationProperties.Name="{Binding RemoveLabel}">
                                            <Path Classes="list-action-icon"
                                                  Fill="Transparent"
                                                  Data="M 3,3 L 11,11 M 11,3 L 3,11"
                                                  StrokeThickness="1.3"
                                                  StrokeLineCap="Round"
                                                  Width="9"
                                                  Height="9"
                                                  Stretch="Uniform" />
                                        </Button>
                                        <Button Classes="list-inline-action"
                                                Theme="{StaticResource BareListButtonTheme}"
                                                Click="OnListItemDetailsClick"
                                                PointerPressed="OnInlineListActionPointerPressed"
                                                ToolTip.Tip="{Binding DetailsLabel}"
                                                AutomationProperties.Name="{Binding DetailsLabel}">
                                            <Path Classes="list-action-icon"
                                                  Fill="Transparent"
                                                  Data="M 7,1 A 6,6 0 1 0 7,13 A 6,6 0 1 0 7,1 M 7,5.3 L 7,10 M 7,3.6 L 7,3.8"
                                                  StrokeThickness="1.3"
                                                  Width="12"
                                                  Height="12"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover">
                                <Setter Property="Background" Value="{DynamicResource ListRowHoverBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:pressed">
                                <Setter Property="Background" Value="{DynamicResource ListRowHoverBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pressed">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle">
                                <Setter Property="Width" Value="16" />
                                <Setter Property="Height" Value="16" />
                                <Setter Property="MinWidth" Value="16" />
                                <Setter Property="MinHeight" Value="16" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle Border.active-indicator">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource MutedText}" />
                                <Setter Property="BorderThickness" Value="1" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle:checked Border.active-indicator">
                                <Setter Property="Background" Value="{DynamicResource ActiveToggleBackground}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ActiveToggleBackground}" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle Path.active-indicator-check">
                                <Setter Property="Opacity" Value="0" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle:checked Path.active-indicator-check">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="ToggleButton.list-active-toggle:disabled Border.active-indicator">
                                <Setter Property="BorderBrush" Value="{DynamicResource DisabledText}" />
                            </Style>
                            <Style Selector="StackPanel.list-action-rail">
                                <Setter Property="Opacity" Value="0.68" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover StackPanel.list-action-rail">
                                <Setter Property="Opacity" Value="0.9" />
                            </Style>
                            <Style Selector="ListBoxItem:selected StackPanel.list-action-rail">
                                <Setter Property="Opacity" Value="0.9" />
                            </Style>
                            <Style Selector="Button.list-inline-action">
                                <Setter Property="Width" Value="20" />
                                <Setter Property="Height" Value="18" />
                                <Setter Property="MinWidth" Value="20" />
                                <Setter Property="MinHeight" Value="18" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style Selector="Button.list-inline-action:pointerover">
                                <Setter Property="Background" Value="{DynamicResource SelectionBackground}" />
                            </Style>
                            <Style Selector="Button.list-inline-action Path.list-action-icon">
                                <Setter Property="Fill" Value="{DynamicResource MutedText}" />
                                <Setter Property="Stroke" Value="{DynamicResource MutedText}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Button.list-inline-action Path.list-action-icon">
                                <Setter Property="Fill" Value="{DynamicResource PrimaryText}" />
                                <Setter Property="Stroke" Value="{DynamicResource PrimaryText}" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <listitems:DataListItemControl MoreRequested="OnDataListItemMoreRequested"
                                                               RemoveRequested="OnDataListItemRemoveRequested" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          ResizeDirection="Columns"
                          Background="{DynamicResource SectionBorder}" />

            <Grid Grid.Column="2" Margin="12,12,6,12">
                <TabControl x:Name="WorkspaceTabs">
                    <TabItem Header="Overview">
                        <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource PanelBackground}">
                            <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1,1,1,0" Padding="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="OverviewTitleText"
                                               Text="No Selection"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <ToggleButton x:Name="OverviewRawButton"
                                                      Content="Raw Data"
                                                      MinWidth="74"
                                                      Padding="8,1"
                                                      IsChecked="True" />
                                        <ToggleButton x:Name="OverviewInjectionsButton"
                                                      Content="Injections"
                                                      MinWidth="78"
                                                      Padding="8,1" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{DynamicResource PanelBackground}"
                                    BorderBrush="{DynamicResource PanelBorder}"
                                    BorderThickness="1,0,1,0"
                                    Padding="12,10">
                                <ScrollViewer MaxHeight="190"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="OverviewDescriptionPanel"
                                                Spacing="2" />
                                </ScrollViewer>
                            </Border>
                            <Grid Grid.Row="2">
                                <Border x:Name="OverviewRawHost" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" Padding="0">
                                    <Grid>
                                        <local:ThermogramGraphControl x:Name="OverviewThermogram" />
                                        <TextBlock x:Name="OverviewText"
                                                   Margin="16"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="False" />
                                    </Grid>
                                </Border>
                                <Border x:Name="OverviewInjectionsHost"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        IsVisible="False">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="OverviewInjectionTable"
                                                    Spacing="0" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Process Data">
                        <processing:ProcessingWorkspaceControl x:Name="ProcessingWorkspace" />
                    </TabItem>
                    <TabItem Header="Analyze Data">
                        <analysis:AnalysisWorkspaceControl x:Name="AnalysisWorkspace" />
                    </TabItem>
                    <TabItem Header="Final Figure">
                        <finalfigure:FinalFigureWorkspaceControl x:Name="FinalFigureWorkspace" />
                    </TabItem>
                </TabControl>
                <results:AnalysisResultWorkspaceControl x:Name="ResultWorkspace"
                                                        IsVisible="False" />
            </Grid>
            <Border x:Name="EmptyWorkspacePanel"
                    Grid.Column="2"
                    Margin="12"
                    Padding="36"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    IsVisible="False">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="440"
                            Spacing="12">
                    <TextBlock Text="Welcome to FT-ITC Analysis"
                               HorizontalAlignment="Center"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}" />
                    <TextBlock Text="Open ITC data to begin processing, analysis, and figure preparation."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedText}" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Spacing="8"
                                Margin="0,8,0,0">
                        <Button x:Name="WelcomeOpenButton"
                                Content="Open File…"
                                MinWidth="110" />
                        <Button x:Name="WelcomeReloadButton"
                                Content="Reload Last File"
                                MinWidth="130" />
                    </StackPanel>
                    <TextBlock x:Name="WelcomeLastFileText"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedText}"
                               FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="20">
                <TextBlock x:Name="StatusText"
                           Foreground="{DynamicResource SecondaryText}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <ProgressBar x:Name="StatusProgressBar"
                             Grid.Column="1"
                             Width="120"
                             Height="7"
                             Minimum="0"
                             Maximum="100"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             IsVisible="False" />
                <TextBlock x:Name="StatusProgressText"
                           Grid.Column="2"
                           Width="38"
                           Margin="6,0,0,0"
                           Foreground="{DynamicResource MutedText}"
                           FontSize="11"
                           TextAlignment="Right"
                           VerticalAlignment="Center"
                           IsVisible="False" />
                <TextBlock x:Name="SecondaryStatusText"
                           Grid.Column="3"
                           Margin="16,0,0,0"
                           Foreground="{DynamicResource MutedText}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
