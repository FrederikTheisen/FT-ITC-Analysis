<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">
  <Identity
    Name="@PACKAGE_IDENTITY@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCHITECTURE@" />

  <Properties>
    <DisplayName>FT-ITC Analysis</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Description>Process, analyze, and present isothermal titration calorimetry data.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="FT-ITC Analysis.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="FT-ITC Analysis"
        Description="Process, analyze, and present isothermal titration calorimetry data."
        BackgroundColor="transparent"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Square150x150Logo="Assets\Square150x150Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation" Executable="FT-ITC Analysis.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:FileTypeAssociation Name="ftxtcproject" Parameters="&quot;%1&quot;" MultiSelectModel="Player">
            <uap:DisplayName>FT-ITC Analysis Project File</uap:DisplayName>
            <uap:Logo>Assets\FTXTCFileLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/vnd.ftitc.project+zip">.ftxtc</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation" Executable="AnalysisITC.Avalonia.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:FileTypeAssociation Name="ftitcproject" Parameters="&quot;%1&quot;" MultiSelectModel="Player">
            <uap:DisplayName>FT-ITC Analysis Project File</uap:DisplayName>
            <uap:Logo>Assets\FTITCFileLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-ftitc-project">.ftitc</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
