# Import the snippet outside site blocks, then replace the site's plain proxy with:
# import ftitc_website_forwarding 127.0.0.1:5000
(ftitc_website_forwarding) {
	@website_proxy {
		path /api/registration /api/registration/activate /api/registration/status /api/viewer/token
		# Header placeholders join repeated values with commas; these checks reject duplicates.
		expression <<CEL
        {env.FTITC_WEBSITE_PROXY_SECRET}.matches('^[a-f0-9]{64}$')
        && {http.request.header.Proxy-Authorization} == 'Bearer ' + {env.FTITC_WEBSITE_PROXY_SECRET}
        && {http.request.header.X-FTITC-Visitor-IP}.matches('^(((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])[.]){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|[0-9a-f]{4}(:[0-9a-f]{4}){7})$')
        CEL
	}
	@website_claim `{http.request.header.Proxy-Authorization} != '' || {http.request.header.X-FTITC-Visitor-IP} != ''`

	route {
		handle @website_proxy {
			vars website_visitor_ip {http.request.header.X-FTITC-Visitor-IP}
			reverse_proxy {args[0]} {
				header_up X-Forwarded-For {vars.website_visitor_ip}
				header_up -Proxy-Authorization
				header_up -X-FTITC-Visitor-IP
				header_up -CF-Connecting-IP
				header_up -CF-Connecting-IPv6
				header_up -X-Real-IP
				header_up -Forwarded
			}
		}
		handle @website_claim {
			respond "Invalid website proxy credentials or visitor address." 403
		}
		handle {
			reverse_proxy {args[0]} {
				header_up X-Forwarded-For {http.request.remote.host}
				header_up -Proxy-Authorization
				header_up -X-FTITC-Visitor-IP
				header_up -CF-Connecting-IP
				header_up -CF-Connecting-IPv6
				header_up -X-Real-IP
				header_up -Forwarded
			}
		}
	}
}
