{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ft-itc.local/schemas/ftxtc/1.3/component.schema.json",
  "title": "FTXTC 1.3 native components",
  "description": "Maintainer schema for experiment.json, solution.json, bootstrap.json and result.json. Component-specific semantic validation is performed by the versioned storage DTO validators.",
  "oneOf": [
    { "$ref": "#/$defs/experiment" },
    { "$ref": "#/$defs/solution" },
    { "$ref": "#/$defs/bootstrap" },
    { "$ref": "#/$defs/result" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "experiment": { "type": "object", "required": ["id", "injections", "processor", "attributes", "segments"], "properties": { "id": { "$ref": "#/$defs/id" }, "injections": { "type": "array" }, "attributes": { "type": "array" }, "segments": { "type": "array" } } },
    "solution": { "type": "object", "required": ["schemaVersion", "id", "experimentId", "modelId", "modelSchemaVersion", "isValid", "parameterBoundaryHit", "fittedParameters", "reportedParameters", "modelOptions"], "properties": { "schemaVersion": { "const": 1 }, "id": { "$ref": "#/$defs/id" }, "experimentId": { "$ref": "#/$defs/id" }, "modelId": { "$ref": "#/$defs/id" }, "modelSchemaVersion": { "type": "integer", "minimum": 1 }, "isValid": { "type": "boolean" }, "parameterBoundaryHit": { "type": "boolean" }, "fittedParameters": { "type": "array" }, "reportedParameters": { "type": "array" }, "modelOptions": { "type": "array" } } },
    "bootstrapReplicate": { "type": "object", "required": ["cellConcentration", "syringeConcentration", "cellVolume", "measuredTemperature", "parameterBoundaryHit", "modelOptions", "segments"], "properties": { "parameterBoundaryHit": { "type": "boolean" } } },
    "bootstrap": { "type": "object", "required": ["schemaVersion", "replicateIndices", "parameterIds", "injectionIds", "replicates", "parameterValues", "parameterLocks", "injections", "injectionIncludes"], "properties": { "schemaVersion": { "const": 1 }, "replicateIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true }, "parameterIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }, "injectionIds": { "type": "array", "items": { "type": "integer" } }, "replicates": { "type": "array", "items": { "$ref": "#/$defs/bootstrapReplicate" } } } },
    "floatWithError": { "type": "object", "required": ["isMissing", "value", "standardDeviation", "lower95", "upper95"] },
    "linearFit": { "type": ["object", "null"], "required": ["slope", "intercept", "referenceX"], "properties": { "slope": { "$ref": "#/$defs/floatWithError" }, "intercept": { "$ref": "#/$defs/floatWithError" }, "referenceX": { "type": "number" } } },
    "advancedAnalyses": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spolarRecord": { "type": "object", "required": ["schemaVersion", "foldedMode", "temperatureMode", "hydrationEntropy", "conformationalEntropy", "residueEstimate", "referenceTemperature", "completedIterations"], "properties": { "schemaVersion": { "const": 1 }, "completedIterations": { "type": "integer", "minimum": 0 } } },
        "electrostatics": { "type": "object", "required": ["schemaVersion", "errorMethod", "ionicStrengthIterations", "counterIonReleaseIterations"], "properties": { "schemaVersion": { "const": 1 }, "counterIonReleaseFit": { "$ref": "#/$defs/linearFit" }, "ionicStrengthIterations": { "type": "integer", "minimum": 0 }, "counterIonReleaseIterations": { "type": "integer", "minimum": 0 } } },
        "protonation": { "type": "object", "required": ["schemaVersion", "bindingEnthalpy", "protonationChange", "errorMethod", "completedIterations"], "properties": { "schemaVersion": { "const": 1 }, "bindingEnthalpy": { "$ref": "#/$defs/floatWithError" }, "protonationChange": { "$ref": "#/$defs/floatWithError" }, "completedIterations": { "type": "integer", "minimum": 0 } } }
      }
    },
    "result": { "type": "object", "required": ["id", "globalSolutionId", "modelId", "isValid", "memberSolutionIds", "constraints", "globalParameters"], "properties": { "id": { "$ref": "#/$defs/id" }, "globalSolutionId": { "$ref": "#/$defs/id" }, "modelId": { "$ref": "#/$defs/id" }, "isValid": { "type": "boolean" }, "memberSolutionIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }, "advancedAnalyses": { "$ref": "#/$defs/advancedAnalyses" } } }
  }
}
